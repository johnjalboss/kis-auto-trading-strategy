# =================================================================
# KIS Auto Trading Bot v11.1.0 Environment Configuration File
# Copy this file to .env and fill in your personal credentials
# =================================================================

# 1. KIS Korea Investment API Credentials (한국투자증권 API Key)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_CANO=your_account_number_here
KIS_ACNT_PRDT_CD=01

# 2. Trading Mode: VPS (Paper Trading 모의투자) or PROD (Live Real Money 실전투자)
TRADING_ENV=VPS

# 3. Telegram Notification Bot Credentials (개인 텔레그램 봇 설정)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 4. Optional External APIs (Optionally add Finnhub & Gemini API Keys for extra speed)
FINNHUB_API_KEY=
GEMINI_API_KEY=
