# KIS API Configuration
# Copy this to .env and fill in your credentials

# ==============================================
# KIS API (Required)
# ==============================================
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_CANO=00000000
KIS_ACNT_PRDT_CD=01

# Trading Mode: VPS=Paper Trading, PROD=Live Trading
TRADING_ENV=VPS

# ==============================================
# Telegram Alerts (Optional but recommended)
# ==============================================
# Create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================
# Risk Management
# ==============================================
# Daily stop loss (0.03 = 3%)
DAILY_STOP_LOSS_PCT=0.03

# Consecutive loss limit before cooldown
CONSECUTIVE_LOSS_LIMIT=3
COOLDOWN_MINUTES=60

# Max exposure per position (0.30 = 30%)
MAX_POSITION_PCT=0.30

# Max concurrent positions
MAX_POSITIONS=5

# Daily trade limit
MAX_DAILY_TRADES=15

# Capital utilization boost scale multiplier (e.g. 1.8 to scale up sizing to near 100%)
CAPITAL_UTILIZATION_SCALE=1.8

# ==============================================
# Strategy
# ==============================================
# Take profit percentage
TAKE_PROFIT_PCT=0.05

# Stop loss ATR multiplier
ATR_STOP_MULTIPLIER=2.0

# ==============================================
# Schedule (KST times)
# ==============================================
PREMARKET_TIME=21:00
MACRO_ANALYSIS_TIME=22:00
SCREENING_TIME=22:30
TRADING_START_TIME=23:30
CLOSE_ALL_TIME=05:55
DAILY_REPORT_TIME=06:00

# ==============================================
# Oracle Cloud / System
# ==============================================
# Keep-alive pulse interval (seconds)
KEEPALIVE_INTERVAL=600

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log

# Database file
DB_FILE=trades.db

# Data retention (days)
DATA_RETENTION_DAYS=90

# Option Bypass (set to false to enable options flow)
DISABLE_OPTIONS_FLOW=false
# yfinance daily OHLCV and earnings fallback blocker (keeps VPS safe from rate limits on KIS fail)
DISABLE_YFINANCE_FALLBACK=true

# Finnhub API Key for fallback data (Official REST)
FINNHUB_API_KEY=

# Screener Candidates Limit (300 is the optimal sweet spot for API stability)
SCREENER_MAX_CANDIDATES=300

# FRED API Key for Federal Reserve Macro Indicators (Optional but highly recommended)
FRED_API_KEY=


